{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "plan"
  ],
  "properties": {
    "type": {
      "const": "plan_result"
    },
    "schema_version": {
      "const": 1
    },
    "plan": {
      "type": "string",
      "minLength": 1
    }
  }
}
