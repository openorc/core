# OpenOrc local development environment (draft)
#
# Copy to `.env` and fill in real values:
#
#   cp .env.example .env
#
# - `.env` is git-ignored and must never be committed.
# - devserver.sh loads `.env`; variables already exported in the shell win.
# - Never put real project refs, tokens, or credentials in tracked files.

# ---------------------------------------------------------------------------
# Supabase (ephemeral dev branches)
# ---------------------------------------------------------------------------

# Ref of the parent hosted Supabase project from which ephemeral dev branches
# are created. Required by devserver.sh when Supabase automation is enabled
# (the default). Take this value from your local configuration.
OPENORC_SUPABASE_PROJECT_REF=

# Optional safety guard.
# When set, devserver.sh refuses branch operations against this project ref.
OPENORC_SUPABASE_PRODUCTION_PROJECT_REF=

# Supabase CLI access token used for branch create/delete against the hosted
# parent project. Obtain from the Supabase dashboard; treat as a secret.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Local ports (optional)
#
# devserver.sh defaults: app 8081, API 3000. Uncomment to override.
# ---------------------------------------------------------------------------

#LOCAL_APP_PORT=8081
#LOCAL_API_PORT=3000

# ---------------------------------------------------------------------------
# OpenOrc process configuration (optional)
#
# OPENORC_ENV labels the process environment (default development).
# API process: OPENORC_API_HOST / OPENORC_API_PORT (default 127.0.0.1:3000).
# OPENORC_API_RELOAD=1 enables ASGI reload for local development.
# Worker process reads VALKEY_URL (default redis://127.0.0.1:6379/0).
# ---------------------------------------------------------------------------

#OPENORC_ENV=development
#OPENORC_API_HOST=127.0.0.1
#OPENORC_API_PORT=3000
#OPENORC_API_RELOAD=1

# ---------------------------------------------------------------------------
# Queue backend (optional)
#
# Defaults to redis://127.0.0.1:6379/0 when unset.
# ---------------------------------------------------------------------------

#VALKEY_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# ngrok (optional)
#
# Reserved ngrok URL for webhook/callback testing.
# ngrok is skipped entirely when this is unset.
# ---------------------------------------------------------------------------

#NGROK_RESERVED_URL=

# ---------------------------------------------------------------------------
# Runtime-generated values
#
# The following are produced per-run by devserver.sh from the ephemeral
# Supabase branch and exported to the process tree. Never add them here
# or to `.env`:
#
#   SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SECRET_KEY
#   DATABASE_URL
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Frontend (apps/app)
#
# The product SPA has its own Vite environment file: apps/app/.env.example
# (copy to apps/app/.env). Vite only exposes VITE_-prefixed variables to the
# client bundle; see apps/app/.env.example for the API base URL contract.
# ---------------------------------------------------------------------------