{
  "name": "@openorc/cline-sdk-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenOrc D3: long-lived Node/TypeScript JSON-RPC 2.0 stdio bridge over the pinned @cline/sdk ClineCore remote client.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.19.0",
  "bin": {
    "cline-sdk-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pretest": "npm run -s build"
  },
  "dependencies": {
    "@cline/sdk": "0.0.90"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
